+
+/** Recovery links are generated locally, never taken from a remote failure payload. */
+export function nativeKindleRecovery(search: string, origin: string): { back: string; convert: string } | null {
+  const params = new URLSearchParams(search);
+  const id = params.get('mokeBookId') || '';
+  if (params.get('moke') !== '1' || !/^[1-9][0-9]*$/.test(id)) return null;
+  try {
+    const context = validateMokeRemoteSource(params.get('file') || '', origin, id);
+    if (context.mime === SOURCE_MIMES.epub) return null;
+    return { back: `/book/${id}`, convert: `/book/${id}?convert=epub` };
+  } catch { return null; }
+}
