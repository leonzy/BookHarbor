   // Relative to the actual parent, not a fixed px size: user font changes scale
   // the image too, including legacy FONT[size] text outside the image wrapper.
   img.style.fontSize = `${plan.fontScale}em`;
   img.style.setProperty('--readest-glyph-ratio', String(plan.aspectRatio));
+  makeGlyphTransparent(img);
 }
