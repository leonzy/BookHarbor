@@ -0,0 +1,70 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { makeGlyphTransparent, whiteGlyphPixels } from '@/utils/transparentGlyph';
+
+function pixels() {
+  const data = new Uint8ClampedArray(4 * 4 * 4).fill(255);
+  data.set([0, 0, 0, 255], (1 * 4 + 1) * 4);
+  return data;
+}
+afterEach(() => { document.body.innerHTML = ''; vi.restoreAllMocks(); });
+
+describe('transparent glyph white matte', () => {
+  it('removes white while keeping black and antialiased grey coverage', () => {
+    const data = pixels(); data.set([128, 128, 128, 255], (1 * 4 + 2) * 4);
+    const result = whiteGlyphPixels(data, 4, 4)!;
+    expect(result.slice(0, 4)).toEqual(new Uint8ClampedArray([0, 0, 0, 0]));
+    expect(result.slice(20, 24)).toEqual(new Uint8ClampedArray([0, 0, 0, 255]));
+    expect(result.slice(24, 28)).toEqual(new Uint8ClampedArray([0, 0, 0, 127]));
+    expect(data[0]).toBe(255); // source buffer not rewritten
+  });
+  it('reproduces grey antialiasing on white and retains existing alpha', () => {
+    for (const grey of [0, 32, 128, 200, 250, 254, 255]) for (const alpha of [128, 255]) {
+      const data = pixels(); data.set([grey, grey, grey, alpha], 24);
+      const result = whiteGlyphPixels(data, 4, 4)!;
+      const originalOnWhite = grey * alpha / 255 + 255 - alpha;
+      expect(Math.abs(255 - result[27]! - originalOnWhite)).toBeLessThanOrEqual(1);
+    }
+  });
+  it('leaves coloured pictures and dark paper unchanged', () => {
+    const coloured = pixels(); coloured.set([200, 20, 20, 255], 24);
+    expect(whiteGlyphPixels(coloured, 4, 4)).toBeNull();
+    const dark = new Uint8ClampedArray(64);
+    for (let i = 3; i < dark.length; i += 4) dark[i] = 255;
+    dark.set([255, 255, 255, 255], 20);
+    expect(whiteGlyphPixels(dark, 4, 4)).toBeNull();
+  });
+  it('does not process blank or oversized images', () => {
+    expect(whiteGlyphPixels(new Uint8ClampedArray(64).fill(255), 4, 4)).toBeNull();
+    expect(whiteGlyphPixels(new Uint8ClampedArray(400 * 100 * 4), 400, 100)).toBeNull();
+  });
+  it('reuses transient results per document and does not reprocess its own data URL', () => {
+    const context = { drawImage: vi.fn(), getImageData: () => ({ data: pixels() }), putImageData: vi.fn() };
+    vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockReturnValue(context as unknown as CanvasRenderingContext2D);
+    vi.spyOn(HTMLCanvasElement.prototype, 'toDataURL').mockReturnValue('data:image/png;base64,transient');
+    for (let i = 0; i < 2; i++) {
+      const image = document.createElement('img'); image.src = 'blob:glyph-cache-test';
+      Object.defineProperties(image, { naturalWidth: { value: 4 }, naturalHeight: { value: 4 } });
+      makeGlyphTransparent(image); makeGlyphTransparent(image);
+      expect(image.src).toBe('data:image/png;base64,transient');
+      expect(image.classList.contains('readest-inline-glyph-transparent')).toBe(true);
+    }
+    expect(context.drawImage).toHaveBeenCalledTimes(1);
+  });
+  it('retains the original if canvas cannot be read', () => {
+    vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockImplementation(() => { throw new Error('tainted'); });
+    const image = document.createElement('img'); image.src = 'blob:glyph-tainted-test';
+    makeGlyphTransparent(image);
+    expect(image.src).toBe('blob:glyph-tainted-test');
+    expect(image.classList.contains('readest-inline-glyph-transparent')).toBe(false);
+  });
+  it('restores the readable original on replacement decode failure', () => {
+    const context = { drawImage: vi.fn(), getImageData: () => ({ data: pixels() }), putImageData: vi.fn() };
+    vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockReturnValue(context as unknown as CanvasRenderingContext2D);
+    vi.spyOn(HTMLCanvasElement.prototype, 'toDataURL').mockReturnValue('data:image/png;base64,failing');
+    const image = document.createElement('img'); image.src = 'blob:glyph-error-test';
+    Object.defineProperties(image, { naturalWidth: { value: 4 }, naturalHeight: { value: 4 } });
+    makeGlyphTransparent(image); image.dispatchEvent(new Event('error'));
+    expect(image.src).toBe('blob:glyph-error-test');
+    expect(image.classList.contains('readest-inline-glyph-transparent')).toBe(false);
+  });
+});
