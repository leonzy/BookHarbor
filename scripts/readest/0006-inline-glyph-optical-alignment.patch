index 0000000..3be0bde
--- /dev/null
+++ b/apps/readest-app/src/utils/transparentGlyph.ts
@@ -0,0 +1,67 @@
+// Cache only within a live section document. No persistent book/file cache and
+// no generated Blob URLs that need a separate lifetime/revoke mechanism.
+const documentGlyphs = new WeakMap<Document, Map<string, string | null>>();
+const processedGlyphs = new WeakSet<HTMLImageElement>();
+
+export function whiteGlyphPixels(data: Uint8ClampedArray, width: number, height: number): Uint8ClampedArray | null {
+  if (!width || !height || width > 384 || height > 64 || data.length !== width * height * 4) return null;
+  let border = 0, whiteBorder = 0, ink = 0;
+  for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
+    const i = (y * width + x) * 4, alpha = data[i + 3]!;
+    const low = Math.min(data[i]!, data[i + 1]!, data[i + 2]!);
+    const high = Math.max(data[i]!, data[i + 1]!, data[i + 2]!);
+    // Keep coloured glyphs/illustrations and non-white paper unchanged.
+    if (alpha > 16 && high - low > 12) return null;
+    if (alpha > 16 && low < 220) ink++;
+    if (!x || !y || x === width - 1 || y === height - 1) {
+      border++;
+      if (alpha < 16 || low >= 245) whiteBorder++;
+    }
+  }
+  if (!ink || whiteBorder / border < 0.6) return null;
+  const result = new Uint8ClampedArray(data.length);
+  for (let i = 0; i < data.length; i += 4) {
+    const grey = (data[i]! + data[i + 1]! + data[i + 2]!) / 3;
+    // Unmatte against white. Black ink stays opaque, white becomes transparent;
+    // grey edge coverage is retained (compositing on white reproduces the input).
+    result[i + 3] = Math.round(data[i + 3]! * (255 - grey) / 255);
+  }
+  return result;
+}
+
+export function makeGlyphTransparent(img: HTMLImageElement): void {
+  const source = img.currentSrc || img.src;
+  if (!source || processedGlyphs.has(img)) return;
+  let cache = documentGlyphs.get(img.ownerDocument);
+  if (!cache) { cache = new Map(); documentGlyphs.set(img.ownerDocument, cache); }
+  let replacement = cache.get(source);
+  if (replacement === undefined) {
+    try {
+      const canvas = img.ownerDocument.createElement('canvas');
+      canvas.width = img.naturalWidth; canvas.height = img.naturalHeight;
+      const context = canvas.getContext('2d', { willReadFrequently: true });
+      if (!context) { cache.set(source, null); return; }
+      context.drawImage(img, 0, 0);
+      const pixels = context.getImageData(0, 0, canvas.width, canvas.height);
+      const transparent = whiteGlyphPixels(pixels.data, canvas.width, canvas.height);
+      if (!transparent) { cache.set(source, null); return; }
+      pixels.data.set(transparent); context.putImageData(pixels, 0, 0);
+      replacement = canvas.toDataURL('image/png');
+      cache.set(source, replacement);
+    } catch {
+      // Unsupported/tainted canvas: retain the readable original, never hide it.
+      cache.set(source, null); return;
+    }
+  }
+  if (!replacement) return;
+  processedGlyphs.add(img);
+  const original = img.src, target = replacement;
+  const restore = () => {
+    cache?.set(source, null);
+    if (img.src === target) { img.classList.remove('readest-inline-glyph-transparent'); img.src = original; }
+  };
+  img.addEventListener('error', restore, { once: true });
+  img.addEventListener('load', () => img.removeEventListener('error', restore), { once: true });
+  img.classList.add('readest-inline-glyph-transparent');
+  img.src = target;
+}
