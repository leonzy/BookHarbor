@@ -0,0 +1,63 @@
+import { isInlineFormattingTag } from './inlineTags';
+
+export type InlineGlyphPlan = { fontScale: number; aspectRatio: number; baseline: boolean };
+
+// Old MOBI publishers used small raster glyphs with much larger width/height
+// attributes. Be deliberately conservative: this is not a general image rule.
+export function planInlineGlyph(img: HTMLImageElement): InlineGlyphPlan | null {
+  const paragraph = img.closest('p[width][height]');
+  const win = img.ownerDocument.defaultView;
+  if (!paragraph || !win || !img.hasAttribute('recindex') || img.closest('a, figure, [role="img"]')) return null;
+  if (!img.naturalWidth || !img.naturalHeight || img.naturalHeight > 64 || img.naturalWidth > 384) return null;
+  const ratio = img.naturalWidth / img.naturalHeight;
+  if (ratio < 0.3 || ratio > 8) return null;
+  if (['width', 'height'].some(name => /%|vw|vh|vmin|vmax/i.test(img.getAttribute(name) || ''))) return null;
+  const imageStyle = win.getComputedStyle(img);
+  if (imageStyle.cssFloat && imageStyle.cssFloat !== 'none') return null;
+  if (['absolute', 'fixed', 'sticky'].includes(imageStyle.position)) return null;
+  if (imageStyle.display && !['inline', 'inline-block'].includes(imageStyle.display)) return null;
+  if (['width', 'height'].some(name => /%|vw|vh|vmin|vmax/i.test(img.style.getPropertyValue(name)))) return null;
+
+  // Do not mistake a figure/caption, table, line-broken plate or block wrapper
+  // for prose. FONT/SPAN and nested inline formatting remain valid text runs.
+  for (const element of paragraph.querySelectorAll('*')) {
+    if (element.localName.toLowerCase() === 'img') continue;
+    if (!isInlineFormattingTag(element.tagName)) return null;
+    const style = win.getComputedStyle(element);
+    // Readest itself makes a sole FONT child flow-root to clear old MOBI
+    // paragraphs. It still represents text, unlike an authored block figure.
+    const legacyTextRun = element.localName.toLowerCase() === 'font' && element.parentElement === paragraph &&
+      element.matches(':only-child') && style.display === 'flow-root' && !/(?:^|;)\s*display\s*:/i.test(element.getAttribute('style') || '');
+    if (style.display && !['inline', 'inline-block', 'contents'].includes(style.display) && !legacyTextRun) return null;
+  }
+  const walker = img.ownerDocument.createTreeWalker(paragraph, 4 /* SHOW_TEXT */);
+  let before: Text | null = null;
+  let after: Text | null = null;
+  let text: Node | null;
+  while ((text = walker.nextNode())) {
+    if (!text.textContent?.trim()) continue;
+    const position = img.compareDocumentPosition(text);
+    if (position & 2 /* PRECEDING */) before = text as Text;
+    if (position & 4 /* FOLLOWING */) { after = text as Text; break; }
+  }
+  const neighbour = before || after;
+  if (!neighbour?.parentElement || !/[\u3400-\u9fff\uf900-\ufaff]/u.test((before?.textContent || '') + (after?.textContent || ''))) return null;
+  const textSize = parseFloat(win.getComputedStyle(neighbour.parentElement).fontSize);
+  const parentSize = parseFloat(win.getComputedStyle(img.parentElement!).fontSize);
+  if (!(textSize > 0 && parentSize > 0)) return null;
+  return {
+    fontScale: textSize / parentSize,
+    aspectRatio: ratio,
+    baseline: imageStyle.verticalAlign === '' || imageStyle.verticalAlign === 'baseline',
+  };
+}
+
+export function applyInlineGlyph(img: HTMLImageElement, plan: InlineGlyphPlan | null): void {
+  if (!plan) return;
+  img.classList.add('readest-inline-glyph', 'has-text-siblings');
+  if (plan.baseline) img.classList.add('has-text-siblings-baseline');
+  // Relative to the actual parent, not a fixed px size: user font changes scale
+  // the image too, including legacy FONT[size] text outside the image wrapper.
+  img.style.fontSize = `${plan.fontScale}em`;
+  img.style.setProperty('--readest-glyph-ratio', String(plan.aspectRatio));
+}
