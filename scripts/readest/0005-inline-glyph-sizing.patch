+import { afterEach, describe, expect, it } from 'vitest';
+import { applyInlineGlyph, planInlineGlyph } from '@/utils/inlineGlyph';
+import { applyImageStyle } from '@/utils/style';
+
+function fixture(content = '<font style="font-size:20px">肠断白</font><img recindex="12" width="93" height="105"><font style="font-size:20px">洲。</font>') {
+  document.body.innerHTML = `<p width="2em" height="2em" style="font-size:16px">${content}</p>`;
+  const image = document.querySelector('img')!;
+  Object.defineProperties(image, {
+    naturalWidth: { configurable: true, value: 39 }, naturalHeight: { configurable: true, value: 44 },
+    complete: { configurable: true, value: true },
+  });
+  return image;
+}
+afterEach(() => { document.body.innerHTML = ''; });
+
+describe('MOBI inline glyphs', () => {
+  it('matches wrapped prose, follows its font rather than the raw image dimensions, and is idempotent', () => {
+    const image = fixture();
+    const plan = planInlineGlyph(image);
+    expect(plan?.fontScale).toBe(1.25);
+    applyImageStyle(document);
+    expect(image.classList.contains('readest-inline-glyph')).toBe(true);
+    expect(image.style.fontSize).toBe('1.25em');
+    applyImageStyle(document);
+    expect(image.style.fontSize).toBe('1.25em');
+    expect(image.getAttribute('width')).toBe('93'); // no source metadata rewrite
+  });
+  it('accepts direct text and nested inline text, and keeps an author baseline offset', () => {
+    for (const html of ['肠断白<img recindex="12" style="vertical-align:-0.15em">洲。', '<span style="font-size:24px"><b>白<img recindex="12" style="vertical-align:-0.15em">洲。</b></span>']) {
+      const image = fixture(html);
+      // jsdom does not resolve inherited font sizes like a browser does.
+      image.parentElement!.style.fontSize = '24px';
+      const plan = planInlineGlyph(image);
+      expect(plan).not.toBeNull();
+      applyInlineGlyph(image, plan);
+      expect(image.style.verticalAlign).toBe('-0.15em');
+      expect(image.classList.contains('has-text-siblings-baseline')).toBe(false);
+    }
+  });
+  it('handles a multi-character bitmap without prescribing a square width', () => {
+    const image = fixture();
+    Object.defineProperty(image, 'naturalWidth', { value: 87 });
+    applyInlineGlyph(image, planInlineGlyph(image));
+    expect(image.classList.contains('readest-inline-glyph')).toBe(true);
+    expect(image.style.width).toBe('');
+    expect(image.style.height).toBe(''); // CSS uses one constrained axis + auto
+  });
+  it('accepts the reader legacy FONT flow-root text wrapper', () => {
+    const image = fixture('<font style="font-size:20px">白<img recindex="12">洲。</font>');
+    const style = document.createElement('style');
+    style.textContent = 'p > font:only-child { display: flow-root; }';
+    document.body.append(style);
+    expect(planInlineGlyph(image)).not.toBeNull();
+  });
+  it.each([
+    ['standalone cover', '<img recindex="12">'],
+    ['caption', '<img recindex="12"><div>插图说明</div>'],
+    ['figure', '<figure><img recindex="12"><figcaption>配图</figcaption></figure>'],
+    ['linked thumbnail', '查看<a href="/photo"><img recindex="12"></a>照片'],
+    ['floating illustration', '书中<img recindex="12" style="float:right">插图'],
+    ['positioned image', '书中<img recindex="12" style="position:absolute">插图'],
+    ['block image', '书中<img recindex="12" style="display:block">插图'],
+    ['authored block wrapper', '<font style="display:block;font-size:20px">图<img recindex="12">示。</font>'],
+    ['percentage image', '书中<img recindex="12" width="50%">插图'],
+    ['CSS percentage image', '书中<img recindex="12" style="width:50%">插图'],
+    ['non-MOBI image', '书中<img>插图'],
+    ['line-broken plate', '图一<br><img recindex="12"><br>说明'],
+  ])('leaves %s alone', (_, html) => {
+    expect(planInlineGlyph(fixture(html))).toBeNull();
+  });
+  it('rejects large illustrations, large scans and extreme aspect ratios', () => {
+    for (const [width, height] of [[600, 400], [500, 50], [40, 1000], [1000, 1000]]) {
+      const image = fixture();
+      Object.defineProperties(image, { naturalWidth: { value: width }, naturalHeight: { value: height } });
+      expect(planInlineGlyph(image)).toBeNull();
+    }
+  });
+  it('waits for actual image dimensions and handles only that late image', () => {
+    const image = fixture();
+    Object.defineProperties(image, { naturalWidth: { configurable: true, value: 0 }, naturalHeight: { configurable: true, value: 0 }, complete: { value: false } });
+    applyImageStyle(document);
+    expect(image.classList.contains('readest-inline-glyph')).toBe(false);
+    Object.defineProperties(image, { naturalWidth: { value: 39 }, naturalHeight: { value: 44 } });
+    image.dispatchEvent(new Event('load'));
+    expect(image.classList.contains('readest-inline-glyph')).toBe(true);
+    expect(image.style.fontSize).toBe('1.25em');
+  });
+  it('does not reclassify a late responsive image after percentage attributes are converted', () => {
+    const image = fixture('图<img recindex="12" width="50%">示。');
+    Object.defineProperties(image, { naturalWidth: { configurable: true, value: 0 }, naturalHeight: { configurable: true, value: 0 }, complete: { value: false } });
+    applyImageStyle(document);
+    expect(image.hasAttribute('width')).toBe(false);
+    Object.defineProperties(image, { naturalWidth: { value: 39 }, naturalHeight: { value: 44 } });
+    image.dispatchEvent(new Event('load'));
+    expect(image.classList.contains('readest-inline-glyph')).toBe(false);
+    applyImageStyle(document);
+    expect(image.classList.contains('readest-inline-glyph')).toBe(false);
+  });
+});
